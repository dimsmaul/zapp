# Copy to .env.test.local for the host-side Rust integration tests.
# Use a disposable local replica set and S3Mock. The tests supply dummy S3 keys.
ZAPP_TEST_MONGODB_URI='mongodb://127.0.0.1:27017/?directConnection=true&replicaSet=zapp'
ZAPP_TEST_S3_PORT=19090
ZAPP_TEST_S3_ENDPOINT=http://127.0.0.1:19090

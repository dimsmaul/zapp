{
  "manifest_version": 3,
  "name": "Zapp",
  "version": "0.1.0",
  "description": "Capture screenshots and tab recordings with diagnostic logs for your Zapp workspace.",
  "minimum_chrome_version": "118",
  "permissions": ["activeTab", "debugger", "offscreen", "scripting", "storage", "tabCapture", "tabs"],
  "optional_host_permissions": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "web_accessible_resources": [
    { "resources": ["preview.html", "popup.html"], "matches": ["http://*/*", "https://*/*"] }
  ],
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "action": {
    "default_title": "Zapp",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" }
  }
}

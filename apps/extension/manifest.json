{
  "manifest_version": 3,
  "name": "Zapp",
  "version": "0.1.0",
  "description": "Capture screenshots and tab recordings with diagnostic logs for your Zapp workspace.",
  "minimum_chrome_version": "118",
  "permissions": ["activeTab", "debugger", "offscreen", "scripting", "storage", "tabCapture", "tabs"],
  "optional_host_permissions": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": {
    "default_title": "Zapp",
    "default_popup": "popup.html"
  }
}

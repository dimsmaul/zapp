# Copy to .env in the Zapp root. Docker Compose loads that file.
# Use a private Cloudflare R2 development bucket.
ZAPP_MONGO_PORT=27017
ZAPP_SERVER_PORT=8080
ZAPP_WEB_PORT=5173
ZAPP_WEB_ORIGIN=http://localhost:5173

# Used by docker-compose.atlas.yml. Leave blank for local MongoDB.
ZAPP_MONGODB_URI=
ZAPP_MONGODB_DATABASE=zapp

# Leave the bucket blank to start without uploads and playback.
ZAPP_STORAGE_BUCKET=
ZAPP_STORAGE_REGION=auto
# Paste the S3 API endpoint from the R2 dashboard, e.g. https://ACCOUNT_ID.r2.cloudflarestorage.com
ZAPP_STORAGE_ENDPOINT=
# Use R2 S3 credentials scoped to this bucket with Object Read & Write permission.
ZAPP_STORAGE_ACCESS_KEY_ID=
ZAPP_STORAGE_SECRET_ACCESS_KEY=
